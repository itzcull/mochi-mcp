{
  "name": "@itzcull/mochi-mcp",
  "version": "0.2.0",
  "description": "MCP server for Mochi Cards API - manage flashcards, decks, and templates via Model Context Protocol",
  "type": "module",
  "license": "MIT",
  "author": "itzcull",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzcull/mochi-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mochi",
    "mochi-cards",
    "flashcards",
    "spaced-repetition",
    "srs",
    "ai"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "mochi-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26"
    },
    "packageManager": {
      "name": "npm"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.0"
  }
}
