{
  "name": "mochi-mcp",
  "version": "1.0.0",
  "description": "MCP server for Mochi Cards API - manage flashcards, decks, and templates via Model Context Protocol",
  "module": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "private": true,
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mochi",
    "mochi-cards",
    "flashcards",
    "spaced-repetition",
    "srs",
    "ai"
  ],
  "bin": {
    "mochi-mcp": "src/index.ts"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
